{
	"name": "obsidian-bijitongbu",
	"version": "3.2.9",
	"description": "Biji Tongbu (笔记同步助手) — sync notes and articles from WeChat Official Accounts and more into Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint ./src --max-warnings=0",
		"lint:fix": "eslint ./src --fix",
		"format": "prettier --write ./src/**/*.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:results": "jest --json --outputFile=results.json",
		"test:coverage": "jest --coverage --coverageReporters json-summary",
		"test:coverage:junit": "jest --coverage --testResultsProcessor='./node_modules/jest-junit-reporter'"
	},
	"keywords": [],
	"author": "",
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@eslint/json": "^0.14.0",
		"@semantic-release/changelog": "^6.0.2",
		"@semantic-release/exec": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/diff-match-patch": "^1.0.32",
		"@types/jest": "^29.4.0",
		"@types/luxon": "^3.1.0",
		"@types/markdown-escape": "^1.1.0",
		"@types/mustache": "^4.2.2",
		"@typescript-eslint/parser": "^8.49.0",
		"@typescript-eslint/utils": "^8.49.0",
		"esbuild": "0.14.47",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"eslint-plugin-prettier": "^5.1.3",
		"globals": "^16.5.0",
		"jest": "^29.4.3",
		"jest-cli": "^29.4.3",
		"jest-junit-reporter": "^1.1.0",
		"marked": "4.3.0",
		"obsidian": "1.12.3",
		"prettier": "^3.2.5",
		"semantic-release": "^19.0.5",
		"ts-jest": "^29.0.5",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	},
	"dependencies": {
		"@omnivore-app/api": "^1.0.3",
		"diff-match-patch": "^1.0.5",
		"js-md5": "^0.8.3",
		"luxon": "^3.1.1",
		"markdown-escape": "^2.0.0",
		"mustache": "^4.2.0",
		"obsidian-daily-notes-interface": "^0.9.4",
		"out-of-character": "^1.2.1"
	},
	"volta": {
		"node": "18.18.0",
		"yarn": "1.22.19"
	}
}
